(* effects_and_io.hml -- Effects + I/O working together
 *
 * Key design principle:
 *   Effects = requests answered by a provider the caller installs (logging)
 *   Results = recoverable errors (Std.Result)
 *   Builtins = I/O (files, http, sleep, json, etc.)
 *
 * This example shows how effects, Results and I/O compose.
 *)
import Std.Json
import Std.List
import Std.Result
import Std.Filesystem
import Std.Int
import Std.Stdio
import Std.String

(* ── Result: recoverable errors around I/O ──────────────── *)
(* Read a file, return Err with a nice message if empty *)
fun read_nonempty path =
  let
    val contents = Filesystem.run (fn () => Filesystem.read_text path)
  in
    if String.length contents = 0 then Result.Err ("file is empty: " ^ path) else Result.Ok contents
  end

val _ = Stdio.println "--- Result errors wrapping I/O ---"

val nonempty_path = "target/hiko_demo_nonempty.txt"

val empty_path = "target/hiko_demo_empty.txt"

val log_path = "target/hiko_log_test.txt"

val _ = Filesystem.run (fn () => Filesystem.write_text nonempty_path "hello")

val _ = Filesystem.run (fn () => Filesystem.write_text empty_path "")

val r1 = read_nonempty nonempty_path

val _ =
  case r1 of
      Result.Ok s => Stdio.println ("Read: " ^ s)
    | Result.Err e => Stdio.println ("Failed: " ^ e)

val r2 = read_nonempty empty_path

val _ =
  case r2 of
      Result.Ok s => Stdio.println ("Read: " ^ s)
    | Result.Err e => Stdio.println ("Failed: " ^ e)

val _ = Filesystem.run (fn () => Filesystem.remove nonempty_path)

val _ = Filesystem.run (fn () => Filesystem.remove empty_path)

(* ── Effect: a log provider around I/O ─────────────────── *)
(* The code that logs does not decide where the log goes. The provider
 * answers each Log request and resumes at once. *)
effect Log of string

fun with_console_log f =
  handle
    f ()
  with
    return x => x
  | Log msg k => let
      val _ = Stdio.println ("  [log] " ^ msg)
    in
      resume k ()
    end

fun process_files () =
  let
    val _ = perform Log "starting"
    val _ = Filesystem.run (fn () => Filesystem.write_text log_path "data")
    val _ = perform Log "wrote file"
    val contents = Filesystem.run (fn () => Filesystem.read_text log_path)
    val _ = perform Log ("read back: " ^ contents)
    val _ = Filesystem.run (fn () => Filesystem.remove log_path)
    val _ = perform Log "cleaned up"
  in
    ()
  end

val _ = Stdio.println "\n--- Log effect interleaved with I/O ---"

val _ = with_console_log process_files

(* ── Counting needs no effect: it is a function of the list ─ *)
val _ = Stdio.println "\n--- Counting list_dir entries ---"

val file_count = List.length (Filesystem.run (fn () => Filesystem.list_entries "."))

val _ = Stdio.println ("Entries in .: " ^ Int.to_string file_count)

val _ = Stdio.println "\nAll effects + I/O demos passed."
