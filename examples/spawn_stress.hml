(* spawn_stress.hml -- Stress child creation and awaiting.
 *
 * This is aimed at the lighter spawn path:
 * - smaller per-child heap/stack startup
 * - shared immutable compiled program across children
 *
 * Increase `count` for a harder local stress run if needed.
 * Note: very large counts will hit the current VM MAX_STACK because the
 * root process builds and traverses one large pid list.
 *)
import Std.List
import Std.Fiber
import Std.Int
import Std.Stdio
import Std.Testing
import Std.Time

(* Milliseconds from the monotonic clock, for interval arithmetic. *)
fun now_ms () = case Time.monotonic_now () of Time.Monotonic ms => ms

val count = 6000

fun spawn_many n acc = if n = 0 then acc else spawn_many (n - 1) (Fiber.spawn (fn () => n) :: acc)

fun await_all pids (acc : int) =
  case pids of
      [] => acc
    | pid :: rest => await_all rest (acc + Fiber.join_or_fail pid)

val t0 = now_ms ()

val pids = spawn_many count []

val spawn_ms = now_ms () - t0

val total = await_all pids 0

val total_ms = now_ms () - t0

val expected = (count * (count + 1)) / 2

val _ = Testing.equal (List.length pids) count "spawned child count"

val _ = Testing.equal total expected "spawn stress sum"

val _ = Stdio.println ("spawn_stress ok: " ^ Int.to_string count ^ " children, spawn " ^ Int.to_string spawn_ms ^ " ms, total " ^ Int.to_string total_ms ^ " ms")
