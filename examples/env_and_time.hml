(* env_and_time.hml -- Demonstrates getenv and epoch builtins *)

(* Read environment variables *)
import Std.Env
import Std.Int
import Std.Stdio
import Std.Time

val home = Env.get "HOME"

val path = Env.get "PATH"

val user = Env.get "USER"

val _ = Stdio.println ("HOME = " ^ home)

val _ = Stdio.println ("USER = " ^ user)

val _ = Stdio.println ("PATH = " ^ path)

(* Missing env var returns empty string *)
val missing = Env.get "THIS_VAR_DOES_NOT_EXIST"

val _ = Stdio.println ("missing var: \"" ^ missing ^ "\"")

(* Unix epoch timestamp *)
val now = Time.to_epoch_ms (Time.now ())

val _ = Stdio.println ("epoch seconds: " ^ Int.to_string now)
