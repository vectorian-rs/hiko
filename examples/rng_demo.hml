(* rng_demo.hml -- Deterministic random number generation *)

(* Seed from bytes *)
import Std.Bytes
import Std.Int
import Std.Random
import Std.Stdio
import Std.Testing

val r0 = Random.seed (Bytes.of_string "hello world")

(* Generate random integers 0-99 *)
val (a, r1) = Random.int_between 100 r0

val (b, r2) = Random.int_between 100 r1

val (c, r3) = Random.int_between 100 r2

val _ = Stdio.println ("Random ints: " ^ Int.to_string a ^ ", " ^ Int.to_string b ^ ", " ^ Int.to_string c)

(* Same seed => same sequence *)
val r0b = Random.seed (Bytes.of_string "hello world")

val (a2, _) = Random.int_between 100 r0b

val _ = Testing.check (a = a2) "same seed produces same value"

val _ = Stdio.println "Determinism check passed"

(* Generate random bytes *)
val (random_bytes, r4) = Random.bytes 8 r3

val _ = Stdio.println ("Random bytes length: " ^ Int.to_string (Bytes.length random_bytes))

(* Different seed => different sequence *)
val r_other = Random.seed (Bytes.of_string "different seed")

val (d, _) = Random.int_between 100 r_other

val _ = Stdio.println ("Different seed: " ^ Int.to_string d)
