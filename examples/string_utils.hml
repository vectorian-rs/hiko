(* string_utils.hml -- Demonstrates string utility builtins *)

(* Case conversion *)
import Std.Int
import Std.Stdio
import Std.String

val _ = Stdio.println (String.upper "hello world")  (* HELLO WORLD *)

val _ = Stdio.println (String.lower "HELLO WORLD")  (* hello world *)

(* Prefix and suffix checks *)
val _ = Stdio.println (Int.to_string (if String.starts_with "hello" "hello.hml" then 1 else 0))

val _ = Stdio.println (Int.to_string (if String.ends_with ".hml" "hello.hml" then 1 else 0))

val _ = Stdio.println (Int.to_string (if String.starts_with "world" "hello.hml" then 1 else 0))

(* string replace *)
val original = "the quick brown fox"

val replaced = String.replace "quick" "slow" original

val _ = Stdio.println replaced  (* the slow brown fox *)

(* Replace all occurrences *)
val csv = "a,b,c,d"

val tsv = String.replace "," "\t" csv

val _ = Stdio.println tsv
