(* json.hml -- Demonstrates JSON builtins *)
import Std.List
import Std.Int
import Std.Json
import Std.Stdio

val data = "{\"name\": \"hiko\", \"version\": \"0.2.0\", \"features\": [\"effects\", \"types\", \"vm\"], \"repo\": {\"url\": \"github.com/vectorian-rs/hiko\", \"stars\": 42}}"

(* Get a top-level field *)
val name = Json.get "name" data

val _ = Stdio.println ("name: " ^ name)

(* Get a nested field with dot notation *)
val url = Json.get "repo.url" data

val _ = Stdio.println ("repo url: " ^ url)

(* Get array element by index *)
val feat = Json.get "features.1" data

val _ = Stdio.println ("feature[1]: " ^ feat)

(* Get all keys *)
val keys = Json.keys data

val _ = Stdio.println ("keys: " ^ Int.to_string (List.length keys))

val _ = List.map (fn k => Stdio.println ("  " ^ k)) keys

(* Get array length *)
val n = Json.length "[1,2,3,4,5]"

val _ = Stdio.println ("array length: " ^ Int.to_string n)
