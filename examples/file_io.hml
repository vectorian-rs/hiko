(* Read, write, and check files *)
import Std.Filesystem
import Std.Stdio
import Std.String
import Std.Testing

val path = "target/hiko_example.txt"

val _ = Filesystem.run (fn () => Filesystem.write_text path "Hello from Hiko!\nLine 2\n")

val contents = Filesystem.run (fn () => Filesystem.read_text path)

val _ = Stdio.println contents

val lines = String.split "\n" contents

fun print_lines xs =
  case xs of
      [] => ()
    | x :: rest => if String.length x > 0 then let
        val _ = Stdio.println ("  > " ^ x)
      in
        print_lines rest
      end else print_lines rest

val _ = print_lines lines

val _ = Testing.check (Filesystem.run (fn () => Filesystem.exists path)) "file should exist"

val _ = Filesystem.run (fn () => Filesystem.remove path)

val _ = Testing.check (not (Filesystem.run (fn () => Filesystem.exists path))) "file should be gone"

val _ = Stdio.println "file_io test passed"
