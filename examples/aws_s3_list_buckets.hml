import Aws.Config
import Aws.S3
import Std.Result

fun print_buckets buckets =
  case buckets of
      [] => ()
    | (name, created, arn) :: rest =>
      let
        val _ = println ("name: " ^ name ^ " | created=" ^ created ^ " | arn=" ^ arn)
      in
        print_buckets rest
      end

val cfg = Config.sso_profile "datadeft-dev"

val client = S3.client cfg

val result = S3.list_buckets client Result.either print_buckets (fn err => println err) result |> Result.ignore
