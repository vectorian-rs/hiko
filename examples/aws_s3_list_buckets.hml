import Aws.Config
import Aws.S3
import Std.Result (Ok, Err)

fun print_buckets buckets =
  case buckets of
    [] => ()
  | (name, created, arn) :: rest =>
      let
        val _ = println ("name: " ^ name ^ " | created=" ^ created ^ " | arn=" ^ arn)
      in print_buckets rest
      end

val result =
  Config.sso_profile "datadeft-dev"
  |> S3.client
  |> S3.list_buckets

val _ =
  case result of
    Ok buckets => print_buckets buckets
  | Err message => println message
