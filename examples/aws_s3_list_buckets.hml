import Aws.Config
import Aws.S3
import Std.Result

fun print_buckets buckets =
  case buckets of
      [] => ()
    | (name, created, arn) :: rest =>
      let
        val _ = println ("name: " ^ name ^ " | created=" ^ created ^ " | arn=" ^ arn)
      in
        print_buckets rest
      end

val _ = Config.sso_profile "datadeft-dev" |> S3.client |> S3.list_buckets |> Result.fold print_buckets (fn err => println err)
