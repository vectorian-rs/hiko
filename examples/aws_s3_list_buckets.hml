import Aws.Config
import Aws.S3
import Std.Result

fun print_bucket bucket =
  case bucket of
    (name, creation_date, arn) =>
      println ("name: " ^ name ^ " | created=" ^ creation_date ^ " | arn=" ^ arn)

fun print_buckets buckets =
  case buckets of
    [] => ()
  | bucket :: rest =>
      let
        val _ = print_bucket bucket
      in
        print_buckets rest
      end

val config = Config.sso_profile "datadeft-dev"

val result = S3.list_buckets config

val _ =
  case result of
    Result.Ok buckets => print_buckets buckets
  | Result.Err message => println message
