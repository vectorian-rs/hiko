import Aws.Config
import Aws.S3
import Std.Result (Ok, Err)

fun print_buckets buckets =
  case buckets of
    [] => ()
  | (name, created, arn) :: rest =>
      let val _ = println ("name: " ^ name ^ " | created=" ^ created ^ " | arn=" ^ arn)
      in print_buckets rest
      end

val cfg = Config.sso_profile "datadeft-dev"
val s3 = S3.client cfg
val result = S3.list_buckets s3

val _ =
  case result of
    Ok buckets => print_buckets buckets
  | Err message => println message
