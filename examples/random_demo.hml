(* random_demo.hml -- OS entropy + deterministic PCG *)

(* Cryptographically secure random bytes from OS *)
import Std.Bytes
import Std.Int
import Std.Random
import Std.Stdio

val b = Random.entropy 16

val _ = Stdio.println ("OS random bytes: " ^ Int.to_string (Bytes.length b) ^ " bytes")

(* Seed PCG from OS entropy for non-deterministic but fast RNG *)
val r = Random.seed (Random.entropy 8)

val (n, _) = Random.int_between 1000 r

val _ = Stdio.println ("PCG seeded from OS entropy: " ^ Int.to_string n)
