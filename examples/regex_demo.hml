(* regex_demo.hml -- Regular expression matching and replacement *)
import Std.List
import Std.Regex
import Std.Stdio
import Std.String

(* Simple matching *)
val _ = Stdio.println "=== Regex match ==="

val _ = Stdio.println (if Regex.matches "^hello" "hello world" then "starts with hello" else "no match")

val _ = Stdio.println (if Regex.matches "[a-z]+@[a-z]+\\.[a-z]+" "foo@bar.com" then "looks like email" else "not email")

val _ = Stdio.println (if Regex.matches "^\\d+$" "12345" then "all digits" else "not all digits")

val _ = Stdio.println (if Regex.matches "^\\d+$" "hello" then "all digits" else "not all digits")

(* Replacement *)
val _ = Stdio.println "\n=== Regex replace ==="

val _ = Stdio.println (Regex.replace "(\\d{4})-(\\d{2})-(\\d{2})" "$2/$3/$1" "2024-01-15")

val _ = Stdio.println (Regex.replace "\\s+" " " "foo  bar   baz")

val _ = Stdio.println (Regex.replace "([a-z])([A-Z])" "$1_$2" "camelCase")

(* Filter lines matching a pattern *)
val _ = Stdio.println "\n=== Filter with regex ==="

val code = "fun foo x = x + 1\nval bar = 42\nfun baz y = y * 2\nval qux = true"

val lines = String.split "\n" code

val funs = List.filter (fn l => Regex.matches "^fun " l) lines

val _ = List.map Stdio.println funs
