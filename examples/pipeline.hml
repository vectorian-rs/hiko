(* pipeline.hml -- Data processing pipeline replacing shell pipes
 *
 * Replaces: find . -name "*.rs" | xargs grep "fn " | wc -l
 * With: glob + read + regex + fold — type-checked, no shell
 *)
import Std.List
import Std.Filesystem
import Std.Int
import Std.Regex
import Std.Stdio
import Std.String

fun lines s = String.split "\n" s

fun is_function_line line = Regex.matches "^\\s*(pub\\s+)?(fn|fun)\\s+" line

fun count_matches xs = List.length xs

(* Count all function definitions across all Rust files *)
val rs_files = Filesystem.glob_matches "crates/**/*.rs"

fun count_fns file = file |> Filesystem.read_text |> lines |> List.filter is_function_line |> count_matches

val counts = rs_files |> List.map (fn f => (f, count_fns f))

fun sum_counts xs =
  case xs of
      [] => 0
    | (_, n) :: rest => n + sum_counts rest

val total = sum_counts counts

val _ = Stdio.println "=== Function count per file ==="

val _ = List.map (fn (f, n) => if n > 0 then Stdio.println ("  " ^ f ^ ": " ^ Int.to_string n) else ()) counts

val _ = Stdio.println ("\nTotal functions: " ^ Int.to_string total)

val _ = Stdio.println ("Files scanned: " ^ Int.to_string (List.length rs_files))
