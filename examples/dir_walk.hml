(* Recursively walk a directory and print all files *)
import Std.Filesystem
import Std.Path
import Std.Stdio

fun walk dir =
  let
    val entries = Filesystem.list_entries dir
  in
    walk_entries dir entries
  end
and walk_entries dir entries =
  case entries of
      [] => ()
    | name :: rest =>
      let
        val full = Path.join [dir, name]
        val _ = if Filesystem.is_directory full then walk full else Stdio.println full
      in
        walk_entries dir rest
      end

val _ = walk "examples"
