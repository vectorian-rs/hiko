(* state.hml -- State by passing it along
 *
 * Hiko has no mutable variables. A computation that keeps state takes the
 * current state as an argument and returns the new one. A recursive helper
 * or a fold does this without any extra machinery.
 *)

(* A counter that increments 5 times *)
import Std.Int
import Std.Stdio
import Std.Testing

fun count_up (n, count) = if n = 0 then count else count_up (n - 1, count + 1)

val result = count_up (5, 0)

val _ = Stdio.println ("Counter after 5 increments: " ^ Int.to_string result)

val _ = Testing.equal result 5 "counter"

(* Accumulate a sum: the accumulator is the state *)
fun sum_list (xs, total : int) =
  case xs of
      [] => total
    | x :: rest => sum_list (rest, total + x)

val total = sum_list ([10, 20, 30, 40], 0)

val _ = Stdio.println ("Sum of [10,20,30,40]: " ^ Int.to_string total)

val _ = Testing.equal total 100 "sum"

(* A step that reads and updates the state returns (result, new state).
 * `increment` returns the old value and stores the old value plus one. *)
fun increment state = (state, state + 1)

fun program state0 =
  let
    val (a, state1) = increment state0
    val (b, state2) = increment state1
    val (c, state3) = increment state2
  in
    (a + b + c, state3)
  end

val (sum, final_state) = program 0

val _ = Stdio.println ("Sum of 0+1+2 = " ^ Int.to_string sum ^ ", final state " ^ Int.to_string final_state)

val _ = Testing.equal ((sum, final_state)) ((3, 3)) "threaded state"
