(* Error handling with Std.Result.
 * Hiko has no exceptions -- recoverable errors are values.
 * Functions that can fail return Ok or Err, and Result.and_then
 * chains steps so the first Err stops the computation.
 *)
import Std.Result
import Std.Int
import Std.Stdio

fun divide a b = if b = 0 then Result.Err "division by zero" else Result.Ok (a / b)

fun safe_compute () =
  divide 100 5
    |> Result.and_then (fn x => Result.map (fn y => x + y) (divide x 4))

val good = safe_compute ()

val _ =
  case good of
      Result.Ok n => Stdio.println ("Success: " ^ Int.to_string n)
    | Result.Err msg => Stdio.println ("Error: " ^ msg)

fun bad_compute () =
  divide 100 0
    |> Result.map (fn x => x + 1)

val bad = bad_compute ()

val _ =
  case bad of
      Result.Ok n => Stdio.println ("Success: " ^ Int.to_string n)
    | Result.Err msg => Stdio.println ("Error: " ^ msg)
