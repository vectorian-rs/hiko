(* effects_overview.hml -- What effects are for in Hiko
 *
 * Effects are a research feature. Two uses are supported:
 *   1. Provider: the handler answers a request and resumes at once
 *      (`| Op x k => resume k answer`). Code that performs the request does
 *      not know which provider is installed, so a test can swap in a mock.
 *   2. Abort: the handler ignores the continuation and returns a value
 *      for the whole `handle` expression (early exit).
 *
 * Not effects:
 *   - recoverable errors use Std.Result;
 *   - I/O uses builtins (read_file, http_get, sleep, ...);
 *   - generators and state use closures and ordinary arguments
 *     (see generator.hml and state.hml).
 *)
import Std.Option
import Std.Result

(* ── Errors are values, not effects ────────────────────────── *)
fun divide a b = if b = 0 then Result.Err "division by zero" else Result.Ok (a / b)

val _ = println "--- Error handling with Result ---"

val _ =
  case divide 10 0 of
      Result.Ok n => println ("Unexpected: " ^ int_to_string n)
    | Result.Err e => println ("Caught: " ^ e)

(* ── 1. Provider ───────────────────────────────────────────── *)
effect Config of string

fun greeting () = perform Config "greeting" ^ ", " ^ perform Config "name"

fun lookup (key : string) table =
  case table of
      [] => "?"
    | (k, v) :: rest => if k = key then v else lookup key rest

(* Answers from a fixed table *)
fun with_config table f =
  handle
    f ()
  with
    return x => x
  | Config key k => resume k (lookup key table)

val _ = println "\n--- Provider ---"

val english = with_config [("greeting", "hello"), ("name", "world")] greeting

val japanese = with_config [("greeting", "konnichiwa"), ("name", "sekai")] greeting

val _ = println english

val _ = println japanese

val _ = assert_eq (english, "hello, world", "provider")

(* ── 2. Abort ──────────────────────────────────────────────── *)
effect Found of int

(* Stop at the first negative number *)
fun scan xs =
  case xs of
      [] => ()
    | x :: rest => if x < 0 then perform Found x else scan rest

fun first_negative xs =
  handle
    let
      val _ = scan xs
    in
      Option.None
    end
  with
    return x => x
  | Found n _ => Option.Some n

val _ = println "\n--- Abort ---"

val _ =
  case first_negative [3, 1, ~4, 1, ~5] of
      Option.Some n => println ("First negative: " ^ int_to_string n)
    | Option.None => println "No negative number"

val _ = assert_eq (first_negative [3, 1, ~4, 1, ~5], Option.Some (~4), "abort")

val _ = assert_eq (first_negative [1, 2], Option.None, "no abort")
