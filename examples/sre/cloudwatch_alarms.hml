(* Check this account's CloudWatch alarms, for people and agents alike: one
   summary line, then a Markdown table of the alarms that need attention,
   worst first. The exit status says the same thing: 0 OK, 2 CRIT (an alarm
   is firing), 3 UNKNOWN (an alarm has insufficient data, or the alarms
   could not be read).

   Needs a hiko built with `--features ext-aws`, an SSO session for the
   profile below (`aws sso login --profile dev`), and a run config that
   allows it: policies/sre-cloudwatch.policy.toml lists `dev`. To use
   another profile, change it in both places. A profile the policy does not
   list is a setup error: hiko stops with exit 1 and no report.

     hiko run --policy sre-cloudwatch examples/sre/cloudwatch_alarms.hml *)
import Std.Result
import Aws.Config
import Aws.CloudWatch
import Sre.Health
import Sre.Report
import Sre.CloudWatchAlarms
import Std.System

val profile = "dev"

val client = CloudWatch.client (Config.sso_profile profile)

val status =
  case CloudWatchAlarms.checks client of
      Result.Ok checks => Report.print ("cloudwatch", checks)
    | Result.Err message =>
        Report.print ("cloudwatch", [("cloudwatch", Health.Unknown, "", message)])

val _ = System.exit (Health.exit_code status)
