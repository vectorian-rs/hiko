(* testing.hml -- unit testing with assert, assert_eq, and Result *)
import Std.List

(* ── Basic assertions ─────────────────────────────────────────────── *)
val _ = Testing.check true "true should be true"

val _ = Testing.check (1 + 1 = 2) "arithmetic"

val _ = Testing.equal (1 + 1) 2 "1 + 1 = 2"

(* ── string operations ────────────────────────────────────────────── *)
val _ = Testing.check (String.upper "hello" = "HELLO") "to_upper"

val _ = Testing.check (String.lower "WORLD" = "world") "to_lower"

val _ = Testing.check (String.trim "  hi  " = "hi") "trim"

val _ = Testing.check (String.replace "foo" "baz" "foo bar foo" = "baz bar baz") "string_replace"

val _ = Testing.check (String.starts_with "hello" "hello.hml") "starts_with"

val _ = Testing.check (String.ends_with ".hml" "hello.hml") "ends_with"

val _ = Testing.check (not (String.starts_with "world" "hello.hml")) "starts_with negative"

(* ── List operations ──────────────────────────────────────────────── *)
val _ = Testing.equal (List.length [1, 2, 3]) 3 "list length"

val _ = Testing.equal (List.length (List.map (fn x => x * 2) [1, 2, 3])) 3 "map preserves length"

val _ = Testing.equal (List.foldl (fn (x, acc) => acc + x) 0 [1, 2, 3]) 6 "foldl sum"

val _ = Testing.equal (List.length (List.filter (fn x => x > 2) [1, 2, 3, 4, 5])) 3 "filter count"

(* ── Pattern matching ─────────────────────────────────────────────── *)
datatype shape =
    Circle of int
  | Rect of int * int

fun area s =
  case s of
      Circle r => r * r * 3
    | Rect (w, h) => w * h

val _ = Testing.equal (area (Circle 5)) 75 "circle area"

val _ = Testing.equal (area (Rect (3, 4))) 12 "rect area"

(* ── JSON round-trip ──────────────────────────────────────────────── *)
import Std.Json

val original = "{\"name\":\"test\",\"value\":42}"

val parsed = Json.parse original

val serialized = Json.to_string parsed

val reparsed = Json.parse serialized

val reserialized = Json.to_string reparsed

val _ = Testing.check (serialized = reserialized) "json round-trip"

(* ── Regex ────────────────────────────────────────────────────────── *)
val _ = Testing.check (Regex.matches "\\d+" "hello123") "regex digits"

val _ = Testing.check (not (Regex.matches "\\d+" "hello")) "regex no digits"

val _ = Testing.check (Regex.replace "-" "_" "a-b-c" = "a_b_c") "regex replace"

(* ── Error handling with Result ──────────────────────────────────── *)
import Std.Result
import Std.Regex
import Std.Stdio
import Std.String
import Std.Testing

fun safe_divide a b = if b = 0 then Result.Err "division by zero" else Result.Ok (a / b)

val _ =
  case safe_divide 10 2 of
      Result.Ok n => Testing.equal n 5 "safe_divide 10/2"
    | Result.Err _ => Testing.check false "should not fail"

val _ =
  case safe_divide 10 0 of
      Result.Ok _ => Testing.check false "should have failed"
    | Result.Err msg => Testing.check (msg = "division by zero") "safe_divide 10/0"

val _ = Stdio.println "All tests passed!"
