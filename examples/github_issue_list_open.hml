(* Example: print open GitHub issues through the policy-gated Gh.Issue API. *)

import Gh.Issue
import Std.Result

val repo = "vectorian-rs/hiko"

val _ = println ("Open issues in " ^ repo ^ ":")

val _ =
  case Issue.issue_list_open repo of
      Result.Ok json => println json
    | Result.Err err => println ("List failed: " ^ err)
