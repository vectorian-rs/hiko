(* string operations *)
import Std.Int
import Std.Stdio
import Std.String

val s = "  Hello, World!  "

val trimmed = String.trim s

val _ = Stdio.println trimmed

val _ = Stdio.println (if String.contains "World" trimmed then "found World" else "not found")

val _ = Stdio.println (String.substring 7 5 trimmed)

val csv = "alice,bob,charlie"

val names = String.split "," csv

fun print_list xs =
  case xs of
      [] => ()
    | x :: rest =>
      let
        val _ = Stdio.println ("  - " ^ x)
      in
        print_list rest
      end

val _ = print_list names

val _ = Stdio.println (Int.to_string (String.length "café"))
