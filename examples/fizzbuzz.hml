fun fizzbuzz n =
  let
    val f = n mod 3 = 0
    val b = n mod 5 = 0
  in
    case (f, b) of
        (true, true) => "FizzBuzz"
      | (true, _) => "Fizz"
      | (_, true) => "Buzz"
      | (_, _) => int_to_string n
  end

fun loop i max = if i > max then () else let
    val _ = println ((int_to_string i) ^ " : " ^ (fizzbuzz i))
  in
    loop (i + 1) max
  end

val _ = loop 1 100
