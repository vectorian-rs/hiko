(* Example: GitHub issue automation with policy-gated builtins.
 *
 * This script demonstrates the `Gh.Issue` API for creating, viewing,
 * and updating issues when `gh` is authenticated and the policy
 * allows the target repository.
 *)

import Gh.Issue
import Std.List
import Std.Result

val repo = "vectorian-rs/hiko"
val title = "Demo issue from Hiko"
val body = "This issue was created by a Hiko script using policy-gated `gh` builtins."

fun issue_number_from_url url = string_to_int (List.last (split (url, "/")))

fun view_issue number =
  case Issue.issue_view repo number of
      Result.Ok json => println ("Issue JSON: " ^ json)
    | Result.Err err => println ("View failed: " ^ err)

fun update_issue number =
  let
    val actions = [Issue.SetTitle "Demo issue from Hiko (updated)", Issue.Close]
    val update_spec = Issue.build_update_json actions
  in
    case Issue.issue_update repo number update_spec of
        Result.Ok json => println ("Updated issue: " ^ json)
      | Result.Err err => println ("Update failed: " ^ err)
  end

(*
 * Create an issue, then only view/update the issue we just created.
 * This avoids touching existing repository issues during the demo.
 *)
val _ =
  case Issue.issue_create repo title body of
      Result.Ok url =>
        let
          val number = issue_number_from_url url
          val _ = println ("Created: " ^ url)
          val _ = view_issue number
          val _ = update_issue number
        in
          ()
        end
    | Result.Err err => println ("Create failed: " ^ err)
