(* Count words in a string *)
import Std.Int
import Std.Stdio
import Std.String

fun length xs =
  case xs of
      [] => 0
    | _ :: rest => 1 + length rest

fun filter p xs =
  case xs of
      [] => []
    | x :: rest => if p x then x :: filter p rest else filter p rest

val text = "the quick brown fox jumps over the lazy dog"

val words = String.split " " text

val count = length words

val _ = Stdio.println ("Text: " ^ text)

val _ = Stdio.println ("Word count: " ^ Int.to_string count)

(* Count words longer than 3 characters *)
val long_words = filter (fn w => String.length w > 3) words

val long_count = length long_words

val _ = Stdio.println ("Words longer than 3 chars: " ^ Int.to_string long_count)
