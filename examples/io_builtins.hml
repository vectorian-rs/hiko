(* io_builtins.hml -- I/O via builtins (not effects)
 *
 * Hiko I/O uses ordinary builtin functions.
 * No effect declarations, no perform, no function coloring.
 *
 *   val contents = read_file "data.txt"
 *   val (status, headers, body) = http_get url
 *   val _ = sleep 100
 *
 * Same source code works in both runtimes:
 *   - Single-threaded: builtins block the thread
 *   - Threaded: builtins suspend the process (no thread blocked)
 *)
import Std.Json
import Std.Env
import Std.Filesystem
import Std.Int
import Std.Stdio
import Std.String
import Std.Time


(* ── File I/O ──────────────────────────────────────────────── *)
val _ = Stdio.println "--- File I/O ---"

val path = "target/hiko_io_demo.txt"

val _ = Filesystem.run (fn () => Filesystem.write_text path "line one\nline two\nline three\n")

val contents = Filesystem.run (fn () => Filesystem.read_text path)

val _ = Stdio.println ("Wrote and read back:\n" ^ contents)

val lines = String.split "\n" contents

fun count_nonempty xs =
  case xs of
      [] => 0
    | x :: rest => if String.length x > 0 then 1 + count_nonempty rest else count_nonempty rest

val _ = Stdio.println ("Non-empty lines: " ^ Int.to_string (count_nonempty lines))

val _ = Filesystem.run (fn () => Filesystem.remove path)

(* ── Environment and time ──────────────────────────────────── *)
val _ = Stdio.println "\n--- Environment ---"

val user = Env.get "USER"

val _ = Stdio.println ("USER=" ^ user)

val now = Time.to_epoch_ms (Time.now ())

val _ = Stdio.println ("epoch=" ^ Int.to_string now)

(* ── JSON round-trip ───────────────────────────────────────── *)
val _ = Stdio.println "\n--- JSON ---"

val data = "{\"lang\": \"hiko\", \"version\": 4, \"typed\": true}"

val parsed = Json.parse data

val back = Json.to_string parsed

val _ = Stdio.println ("Parsed and re-serialized: " ^ back)

(* ── Sleep ─────────────────────────────────────────────────── *)
val _ = Stdio.println "\n--- Sleep ---"

val before = Time.to_epoch_ms (Time.now ())

val _ = Time.sleep (Time.from_ms 100)

val after = Time.to_epoch_ms (Time.now ())

val _ = Stdio.println ("Slept ~100ms (epoch delta: " ^ Int.to_string (after - before) ^ ")")

val _ = Stdio.println "\nAll I/O builtin demos passed."
