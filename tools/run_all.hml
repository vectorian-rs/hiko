(* tool: run_all
 * description: Run all examples and report per-example timing
 *
 * Build hiko-cli with every builtin first; the default build leaves out
 * regex, JSON and dates, which some examples use:
 *
 *   cargo build --release -p hiko-cli --features builtin-all
 *
 * Requires an exec-enabled VM. The checked-in run config at
 * `policies/test-runner.policy.toml` already allows:
 *
 *   ./target/release/hiko-cli
 *   ./target/release/hiko-vm-hiko-run-all-policy
 *   ./hiko-vm-hiko-run-all-policy/target/release/hiko-vm-hiko-run-all-policy
 *
 * Typical setup for the local runtime-backed runner:
 *
 *   cd hiko-vm-hiko-run-all-policy && cargo build --release
 *   cd ..
 *   ./hiko-vm-hiko-run-all-policy/target/release/hiko-vm-hiko-run-all-policy tools/run_all.hml
 *)

import Std.List
import Std.Env
import Std.Exec
import Std.Filesystem
import Std.Int
import Std.Stdio
import Std.String
import Std.System
import Std.Time

(* Milliseconds from the monotonic clock, for interval arithmetic. *)
fun now_ms () = case Time.monotonic_now () of Time.Monotonic ms => ms

val examples = Filesystem.run (fn () => Filesystem.glob_matches "examples/*.hml")

val cwd = Env.get "PWD"

val cwd_prefix = cwd ^ "/"

(* Skip examples that are intentionally failing or externally flaky. *)
val skip = ["examples/cycle_a.hml", "examples/cycle_b.hml", "examples/should_fail_io_stdout.hml", "examples/should_fail_io_stdin.hml", "examples/should_fail_io_read_file.hml", "examples/should_fail_io_read_file_bytes.hml", "examples/should_fail_io_write_file.hml", "examples/should_fail_io_list_dir.hml", "examples/should_fail_io_glob.hml", "examples/should_fail_io_walk_dir.hml"]

fun should_skip file = List.any (fn s => String.ends_with s file) skip

fun display_name file = if String.starts_with cwd_prefix file then String.substring (String.length cwd_prefix) (String.length file - String.length cwd_prefix) file else file

fun failure_suffix stderr = let
    val msg = String.trim stderr
  in
    if msg = "" then "" else ": " ^ msg
  end

val runtime_runner_root = "./hiko-vm-hiko-run-all-policy/target/release/hiko-vm-hiko-run-all-policy"

val runtime_runner_local = "./target/release/hiko-vm-hiko-run-all-policy"

fun example_exec file = if Filesystem.run (fn () => Filesystem.exists runtime_runner_root) then (runtime_runner_root, [file]) else if Filesystem.run (fn () => Filesystem.exists runtime_runner_local) then (runtime_runner_local, [file]) else ("./target/release/hiko-cli", ["run", file])

fun run_example file = let
    val name = display_name file
    val t0 = now_ms ()
    val (command, args) = example_exec file
    val (code, _, stderr) = Exec.run command args
    val elapsed = now_ms () - t0
    val _ = if code = 0 then Stdio.println ("  PASS  " ^ name ^ " (" ^ Int.to_string elapsed ^ " ms)") else Stdio.println ("  FAIL  " ^ name ^ " (" ^ Int.to_string elapsed ^ " ms)" ^ failure_suffix stderr)
  in
    if code = 0 then (1, 0, elapsed) else (1, 1, elapsed)
  end

fun run_examples files run skipped failed child_ms = case files of
      [] => (run, skipped, failed, child_ms)
    | file :: rest => if should_skip file then let
        val _ = Stdio.println ("  SKIP  " ^ display_name file)
      in
        run_examples rest run (skipped + 1) failed child_ms
      end else let
        val (run_inc, fail_inc, elapsed) = run_example file
      in
        run_examples rest (run + run_inc) skipped (failed + fail_inc) (child_ms + elapsed)
      end

val _ = Stdio.println "Running examples..."

val harness_start = now_ms ()

val (run_count, skipped_count, failed_count, child_ms) = run_examples examples 0 0 0 0

val wall_ms = now_ms () - harness_start

val _ = Stdio.println ""

val _ = Stdio.println ("Summary: " ^ Int.to_string run_count ^ " run, " ^ Int.to_string skipped_count ^ " skipped, " ^ Int.to_string failed_count ^ " failed")

val _ = Stdio.println ("Child runtime: " ^ Int.to_string child_ms ^ " ms")

val _ = Stdio.println ("Wall clock: " ^ Int.to_string wall_ms ^ " ms")

val _ = if failed_count = 0 then () else System.panic (Int.to_string failed_count ^ " example(s) failed")
