import __Builtin.Http

structure Client = struct
  fun get url = BuiltinHttp.get url

  fun request args = BuiltinHttp.request args

  fun request_json args = BuiltinHttp.request_json args

  fun request_msgpack args = BuiltinHttp.request_msgpack args

  fun request_bytes args = BuiltinHttp.request_bytes args
end
