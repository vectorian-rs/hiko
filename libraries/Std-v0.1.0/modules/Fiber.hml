import Std.Either
import Std.Result (Ok, Err)
import __Builtin.Process

structure FiberInternal = struct
  fun spawn_all fs =
    case fs of
        [] => []
      | f :: rest => BuiltinProcess.spawn_raw f :: spawn_all rest

  fun cancel_all fibers =
    case fibers of
        [] => ()
      | fiber :: rest =>
        let
          val _ = BuiltinProcess.cancel_raw fiber
        in
          cancel_all rest
        end

  fun remove_first (target : 'a pid) fibers =
    case fibers of
        [] => []
      | fiber :: rest => if fiber = target then rest else fiber :: remove_first target rest

  fun reap_all fibers =
    case fibers of
        [] => ()
      | fiber :: rest =>
        let
          val _ = BuiltinProcess.await_result_raw fiber
        in
          reap_all rest
        end

  (* The value joined from `fiber`, in a list of (fiber, value) pairs. *)
  fun value_of (fiber : 'a pid) joined =
    case joined of
        [] => panic "Fiber.join_all: a fiber was not joined"
      | (other, value) :: rest => if other = fiber then value else value_of fiber rest

  (* The values of `fibers`, in order, from (fiber, value) pairs. *)
  fun in_order fibers joined =
    case fibers of
        [] => []
      | fiber :: rest => value_of fiber joined :: in_order rest joined
end

structure Fiber = struct
  (* A fiber that returns an 'a: joining it gives back an 'a. *)
  type 'a t = 'a pid

  type error = BuiltinProcess.error

  fun render_error err =
    case err of
        BuiltinProcess.RuntimeError msg => msg
      | BuiltinProcess.Cancelled => "cancelled"
      | BuiltinProcess.FuelExhausted => "fuel exhausted"
      | BuiltinProcess.AlreadyJoined => "fiber already joined"
      | BuiltinProcess.HeapObjectLimitExceeded (live, limit) => "heap limit exceeded: " ^ int_to_string live ^ " objects (max " ^ int_to_string limit ^ ")"

  fun spawn f = BuiltinProcess.spawn_raw f

  fun join fiber =
    case BuiltinProcess.await_result_raw fiber of
        BuiltinProcess.Ok value => Ok value
      | BuiltinProcess.Err err => Err err

  fun join_or_fail fiber =
    case Fiber.join fiber of
        Ok value => value
      | Err err => panic ("Fiber.join_or_fail: " ^ Fiber.render_error err)

  fun cancel fiber = BuiltinProcess.cancel_raw fiber

  (* Join every fiber, as they finish. The first failure cancels and reaps
     the others and is returned; otherwise the values, in the order of
     `fibers`. *)
  fun join_all fibers =
    let
      fun wait pending joined =
        case pending of
            [] => Ok (FiberInternal.in_order fibers joined)
          | _ =>
            let
              val done = BuiltinProcess.wait_any_raw pending
              val rest = FiberInternal.remove_first done pending
            in
              case Fiber.join done of
                  Ok value => wait rest ((done, value) :: joined)
                | Err err =>
                  let
                    val _ = FiberInternal.cancel_all rest
                    val _ = FiberInternal.reap_all rest
                  in
                    Err err
                  end
            end
    in
      wait fibers []
    end

  (* Run `f` and `g` at once. The first failure cancels the other. *)
  fun both (f, g) =
    let
      val left = BuiltinProcess.spawn_raw (fn () => Either.Left (f ()))
      val right = BuiltinProcess.spawn_raw (fn () => Either.Right (g ()))
    in
      case Fiber.join_all [left, right] of
          Ok [Either.Left left_value, Either.Right right_value] => Ok (left_value, right_value)
        | Ok _ => panic "Fiber.both: results out of order"
        | Err err => Err err
    end

  fun all fs = Fiber.join_all (FiberInternal.spawn_all fs)

  fun first (f, g) =
    let
      val left = BuiltinProcess.spawn_raw f
      val right = BuiltinProcess.spawn_raw g
      val winner = BuiltinProcess.wait_any_raw [left, right]
      val loser = if winner = left then right else left
      val _ = BuiltinProcess.cancel_raw loser
      val _ = BuiltinProcess.await_result_raw loser
    in
      Fiber.join winner
    end

  fun any fs =
    let
      val fibers = FiberInternal.spawn_all fs
    in
      case fibers of
          [] => Err (BuiltinProcess.RuntimeError "Fiber.any: empty list")
        | _ =>
          let
            val winner = BuiltinProcess.wait_any_raw fibers
            val losers = FiberInternal.remove_first winner fibers
            val _ = FiberInternal.cancel_all losers
            val _ = FiberInternal.reap_all losers
          in
            Fiber.join winner
          end
    end
end
