import __Builtin.Stdio

signature STDIO = sig
  val print : string -> unit
  val println : string -> unit
  val eprint : string -> unit
  val eprintln : string -> unit
  val read_line : unit -> string
  val read_stdin : unit -> string
end

structure Stdio :> STDIO = struct
  fun print text = BuiltinStdio.print text

  fun println text = BuiltinStdio.println text

  fun eprint text = BuiltinStdio.eprint text

  fun eprintln text = BuiltinStdio.eprintln text

  fun read_line () = BuiltinStdio.read_line ()

  fun read_stdin () = BuiltinStdio.read_stdin ()
end
