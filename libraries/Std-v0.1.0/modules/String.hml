import __Builtin.String

signature STRING = sig
  val length : string -> int
  val substring : int -> int -> string -> string
  val contains : string -> string -> bool
  val starts_with : string -> string -> bool
  val ends_with : string -> string -> bool
  val trim : string -> string
  val split : string -> string -> string list
  val replace : string -> string -> string -> string
  val join : string -> string list -> string
  val upper : string -> string
  val lower : string -> string
end

structure String :> STRING = struct
  fun length text = BuiltinString.length text

  fun substring start len text = BuiltinString.substring (text, start, len)

  fun contains needle text = BuiltinString.contains (text, needle)

  fun starts_with prefix text = BuiltinString.starts_with (text, prefix)

  fun ends_with suffix text = BuiltinString.ends_with (text, suffix)

  fun trim text = BuiltinString.trim text

  fun split sep text = BuiltinString.split (text, sep)

  fun replace pattern replacement text = BuiltinString.replace (text, pattern, replacement)

  fun join sep parts = BuiltinString.join (parts, sep)

  fun upper text = BuiltinString.upper text

  fun lower text = BuiltinString.lower text
end
