import Std.Option
import Std.Time
import __Builtin.Date

structure Date = struct
  datatype timezone = Tz of string

  datatype date = Dt of string

  val utc = Tz (BuiltinDate.utc_tz ())

  fun local_timezone () =
    case BuiltinDate.local_tz () of
        (true, text) =>
        let
          val tz = Tz text
        in
          Option.Some tz
        end
      | (false, _) => Option.None

  fun timezone_of name =
    case BuiltinDate.timezone_of name of
        (true, text) =>
        let
          val tz = Tz text
        in
          Option.Some tz
        end
      | (false, _) => Option.None

  fun fixed_offset minutes = Tz (BuiltinDate.fixed_offset minutes)

  fun timezone_name (Tz text) = text

  fun utc_now () = Dt (BuiltinDate.utc_now ())

  fun now_in (Tz text) = Dt (BuiltinDate.now_in text)

  fun from_instant (instant, Tz text) = Dt (BuiltinDate.from_instant (Time.to_epoch_ms instant, text))

  fun to_instant (Dt text) = Time.of_epoch_ms (BuiltinDate.to_epoch_ms text)

  fun to_timezone (Dt text) = Tz (BuiltinDate.to_timezone text)

  fun in_timezone (Dt date_text, Tz tz_text) = Dt (BuiltinDate.in_timezone (date_text, tz_text))

  fun year (Dt text) = BuiltinDate.year text

  fun month (Dt text) = BuiltinDate.month text

  fun day (Dt text) = BuiltinDate.day text

  fun hour (Dt text) = BuiltinDate.hour text

  fun minute (Dt text) = BuiltinDate.minute text

  fun second (Dt text) = BuiltinDate.second text

  fun millisecond (Dt text) = BuiltinDate.millisecond text

  fun weekday (Dt text) = BuiltinDate.weekday text

  fun to_rfc9557 (Dt text) = text

  fun to_rfc3339 (Dt text) = BuiltinDate.to_rfc3339 text

  fun to_rfc2822 (Dt text) = BuiltinDate.to_rfc2822 text

  fun format (pattern, Dt text) = BuiltinDate.format (pattern, text)

  fun parse_rfc3339 text =
    case BuiltinDate.parse_rfc3339 text of
        (true, canonical) =>
        let
          val date = Dt canonical
        in
          Option.Some date
        end
      | (false, _) => Option.None

  fun parse_rfc9557 text =
    case BuiltinDate.parse_rfc9557 text of
        (true, canonical) =>
        let
          val date = Dt canonical
        in
          Option.Some date
        end
      | (false, _) => Option.None
end
