import __Builtin.Exec

signature EXEC = sig
  val run : string -> string list -> int * string * string
end

structure Exec :> EXEC = struct
  (* Advanced, policy-gated process execution. Prefer domain-specific
   * capabilities when available. Returns (exit_code, stdout, stderr).
   *)
  fun run command args = BuiltinExec.exec_raw (command, args)
end
