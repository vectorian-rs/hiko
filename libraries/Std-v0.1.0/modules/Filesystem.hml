import __Builtin.Filesystem
import __Builtin.Path

structure Filesystem = struct
  effect ReadText of string

  effect ReadBytes of string

  effect WriteText of string * string

  effect Exists of string

  effect ListEntries of string

  effect Remove of string

  effect CreateDirectory of string

  effect IsDirectory of string

  effect IsRegularFile of string

  effect GlobMatches of string

  effect Walk of string

  fun read_text path = perform ReadText path

  fun read_bytes path = perform ReadBytes path

  fun write_text path content = perform WriteText (path, content)

  fun exists path = perform Exists path

  fun list_entries path = perform ListEntries path

  fun remove path = perform Remove path

  fun create_directory path = perform CreateDirectory path

  fun is_directory path = perform IsDirectory path

  fun is_regular_file path = perform IsRegularFile path

  fun glob_matches pattern = perform GlobMatches pattern

  fun walk path = perform Walk path

  fun join parts = BuiltinPath.join parts

  fun run f =
    handle
      f ()
    with
      return x => x
    | ReadText path k => resume k (BuiltinFilesystem.read_text path)
    | ReadBytes path k => resume k (BuiltinFilesystem.read_bytes path)
    | WriteText pair k => let
        val (path, content) = pair
      in
        resume k (BuiltinFilesystem.write_text (path, content))
      end
    | Exists path k => resume k (BuiltinFilesystem.exists path)
    | ListEntries path k => resume k (BuiltinFilesystem.list_entries path)
    | Remove path k => resume k (BuiltinFilesystem.remove path)
    | CreateDirectory path k => resume k (BuiltinFilesystem.create_directory path)
    | IsDirectory path k => resume k (BuiltinFilesystem.is_directory path)
    | IsRegularFile path k => resume k (BuiltinFilesystem.is_regular_file path)
    | GlobMatches pattern k => resume k (BuiltinFilesystem.glob pattern)
    | Walk path k => resume k (BuiltinFilesystem.walk path)
end
