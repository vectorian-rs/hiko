import __Builtin.Testing

signature TESTING = sig
  val check : bool -> string -> unit
  val equal : 'a -> 'a -> string -> unit
  val fail : string -> 'a
end

structure Testing :> TESTING = struct
  fun check condition message = BuiltinTesting.assert (condition, message)

  fun equal actual expected message = BuiltinTesting.assert_eq (actual, expected, message)

  fun fail message = BuiltinTesting.panic message
end
