(* check_tla.hml -- Run maintained TLA+ specs with tla-checker.
 *
 * Usage:
 *   hiko run scripts/check_tla.hml
 *
 * Requires an exec-enabled VM with the `tla` binary from the `tla-checker`
 * crate available on PATH.
 *)

import Std.List
import Std.Exec
import Std.Filesystem
import Std.Stdio
import Std.String
import Std.System

fun shell_quote s = "'" ^ String.replace "'" "'\\''" s ^ "'"

fun join_args args = case args of
      [] => ""
    | [x] => shell_quote x
    | x :: rest => shell_quote x ^ " " ^ join_args rest

fun run_check name args = let
    val command = "tla"
    val _ = Stdio.println ("TLA  " ^ name)
    val _ = Stdio.println ("  " ^ command ^ " " ^ join_args args)
    val (code, stdout, stderr) = Exec.run command args
    val _ = if String.trim stdout = "" then () else Stdio.print stdout
    val _ = if String.trim stderr = "" then () else Stdio.print stderr
  in
    if code = 0 then Stdio.println ("PASS " ^ name) else System.panic ("TLA check failed: " ^ name)
  end

fun run_expect_failure name args = let
    val command = "tla"
    val _ = Stdio.println ("TLA  " ^ name ^ " (expected failure)")
    val _ = Stdio.println ("  " ^ command ^ " " ^ join_args args)
    val (code, stdout, stderr) = Exec.run command args
    val _ = if String.trim stdout = "" then () else Stdio.print stdout
    val _ = if String.trim stderr = "" then () else Stdio.print stderr
  in
    if code = 0 then System.panic ("TLA negative check unexpectedly passed: " ^ name) else Stdio.println ("PASS " ^ name ^ " failed as expected")
  end

val trace_dir = "target/tla"

val _ = Filesystem.run (fn () => if Filesystem.exists trace_dir then () else Filesystem.create_directory trace_dir)

val checks = [("ProcessLifecycle validate", ["specs/tla/ProcessLifecycle.tla", "--config", "specs/tla/ProcessLifecycle.cfg", "--validate"]), ("ThreadedSchedulerImpl validate", ["specs/tla/ThreadedSchedulerImpl.tla", "--config", "specs/tla/ThreadedSchedulerImpl.cfg", "--validate"]), ("NumericWidthSemantics model", ["specs/tla/NumericWidthSemantics.tla", "--config", "specs/tla/NumericWidthSemantics.cfg", "--allow-deadlock", "--trace-json", "target/tla/numeric_width_semantics.trace.json"]), ("WaitAnyLeftmost model", ["specs/tla/WaitAnyLeftmost.tla", "--config", "specs/tla/WaitAnyLeftmost.cfg", "--allow-deadlock", "--trace-json", "target/tla/wait_any_leftmost.trace.json"]), ("WaitAnyLeftmost right-notifier scenario", ["specs/tla/WaitAnyLeftmost.tla", "--config", "specs/tla/WaitAnyLeftmost.cfg", "--allow-deadlock", "--scenario", "@specs/tla/WaitAnyLeftmostRightNotifier.scenario", "--trace-json", "target/tla/wait_any_leftmost_right_notifier.trace.json"]), ("CancelIoRace model", ["specs/tla/CancelIoRace.tla", "--config", "specs/tla/CancelIoRace.cfg", "--allow-deadlock", "--trace-json", "target/tla/cancel_io_race.trace.json"]), ("CancelIoRace stale-completion scenario", ["specs/tla/CancelIoRace.tla", "--config", "specs/tla/CancelIoRace.cfg", "--allow-deadlock", "--scenario", "@specs/tla/CancelIoRaceStaleCompletion.scenario", "--trace-json", "target/tla/cancel_io_race_stale_completion.trace.json"]), ("WaitAnyLeftmost liveness", ["specs/tla/WaitAnyLeftmost.tla", "--config", "specs/tla/WaitAnyLeftmostLive.cfg", "--check-liveness", "--allow-deadlock", "--trace-json", "target/tla/wait_any_leftmost_live.trace.json"]), ("CancelIoRace liveness", ["specs/tla/CancelIoRace.tla", "--config", "specs/tla/CancelIoRaceLive.cfg", "--check-liveness", "--allow-deadlock", "--trace-json", "target/tla/cancel_io_race_live.trace.json"]), ("ThreadedSchedulerImpl quick", ["specs/tla/ThreadedSchedulerImpl.tla", "--config", "specs/tla/ThreadedSchedulerImpl.cfg", "-c", "MaxProcesses=2", "--quick", "--max-states", "5000", "--allow-deadlock", "--trace-json", "target/tla/threaded_scheduler_impl.trace.json"])]

val negative_checks = [("Broken wait_any notifier delivery", ["specs/tla/broken/WaitAnyNotifierBroken.tla", "--config", "specs/tla/broken/WaitAnyNotifierBroken.cfg", "--allow-deadlock", "--trace-json", "target/tla/broken_wait_any_notifier.trace.json"]), ("Threaded scheduler without recheck after park", ["specs/tla/ThreadedSchedulerImpl.tla", "--config", "specs/tla/broken/ThreadedSchedulerNoRecheck.cfg", "--allow-deadlock", "--trace-json", "target/tla/broken_threaded_no_recheck.trace.json"]), ("Threaded scheduler without tombstone reaping", ["specs/tla/ThreadedSchedulerImpl.tla", "--config", "specs/tla/broken/ThreadedSchedulerNoReap.cfg", "--allow-deadlock", "--trace-json", "target/tla/broken_threaded_no_reap.trace.json"])]

fun run_all xs = case xs of
      [] => ()
    | (name, args) :: rest => let
        val _ = run_check name args
      in
        run_all rest
      end

fun run_all_expected_failures xs = case xs of
      [] => ()
    | (name, args) :: rest => let
        val _ = run_expect_failure name args
      in
        run_all_expected_failures rest
      end

val _ = run_all checks

val _ = run_all_expected_failures negative_checks

val _ = Stdio.println "All TLA checks passed"
