import Std.Result

(*!
 * Amazon CloudWatch alarms, from the hiko-ext-aws extension. Needs
 * `cloudwatch = true` in `[extensions.aws]`.
 *)
structure CloudWatch = struct
  type client = aws_cloudwatch_client

  type error = string

  (*! Name, state (`OK`, `ALARM` or `INSUFFICIENT_DATA`), source
      (`Namespace/MetricName`, `metric math` or `composite`), when the alarm
      entered its state (RFC 3339, whole seconds; CloudWatch's
      StateTransitionedTimestamp, which other updates do not move), and the
      reason CloudWatch gives. *)
  type alarm = string * string * string * string * string

  fun name (name, _, _, _, _) = name
  fun state (_, state, _, _, _) = state
  fun source (_, _, source, _, _) = source
  fun updated (_, _, _, updated, _) = updated
  fun reason (_, _, _, _, reason) = reason

  (*! A reusable client. *)
  fun client config = aws_cloudwatch_client config

  (*! Every metric and composite alarm in the config's region. *)
  fun alarms client =
    case aws_cloudwatch_describe_alarms client of
        (true, alarms, _) => Result.Ok alarms
      | (false, _, message) => Result.Err message
end
