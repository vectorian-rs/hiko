import Std.Result

(*!
 * Amazon S3, from the hiko-ext-aws extension. Needs `s3 = true` in
 * `[extensions.aws]`.
 *)
structure S3 = struct
  type client = aws_s3_client

  (*! Bucket name, creation date and ARN. *)
  type bucket = string * string * string

  (*! A reusable client. *)
  fun client config = aws_s3_client config

  (*! Every bucket in the account. *)
  fun list_buckets client =
    case aws_s3_list_buckets client of
        (true, buckets, _) => Result.Ok buckets
      | (false, _, message) => Result.Err message
end
