(*!
 * AWS configuration, from the hiko-ext-aws extension.
 *
 * Credentials come only from AWS SSO: a config names a direct SSO profile
 * (`sso_session` or `sso_start_url`, with `sso_account_id`,
 * `sso_role_name` and `region`), and its cached SSO token is exchanged for
 * role credentials. A profile with static keys, `credential_process`,
 * `role_arn`, `source_profile`, `credential_source` or a web identity is
 * refused. Environment variables, the instance metadata service and the
 * SDK's other providers are never used, nor are endpoint URLs set in the
 * environment or the profile. Nothing is loaded until a service call
 * needs it, on the I/O pool. The run config's `[extensions.aws]` table
 * lists the profiles a script may use.
 *)
structure Config = struct
  (*! An AWS configuration. *)
  type config = aws_config

  (*! Credentials from the named SSO profile's cached token, and the
   * profile's region. A profile that is not a direct SSO profile is an
   * error when a service call loads it. *)
  fun sso_profile profile = aws_config_sso_profile profile
end
