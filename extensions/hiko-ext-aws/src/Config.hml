(*!
 * AWS configuration, from the hiko-ext-aws extension.
 *
 * Credentials come only from AWS SSO. A config names a direct SSO profile
 * in `~/.aws/config`: `sso_session` (whose section gives `sso_start_url`
 * and `sso_region`) or the legacy `sso_start_url` and `sso_region`, with
 * `sso_account_id`, `sso_role_name` and `region`. Its cached SSO token in
 * `~/.aws/sso/cache` is exchanged with the SSO portal of `sso_region` for
 * role credentials; an expired token is an error asking for
 * `aws sso login`, never refreshed here. A profile with static keys,
 * `credential_process`, `role_arn`, `source_profile`, `credential_source`,
 * `login_session` or a web identity is refused. Environment variables, the
 * instance metadata service and the SDK's other providers are never used
 * for credentials, `AWS_CONFIG_FILE` and `AWS_SHARED_CREDENTIALS_FILE` are
 * ignored, and endpoint URLs set in the environment or the profile are not
 * used. Nothing is loaded until a service call needs it, on the I/O pool.
 * The run config's `[extensions.aws]` table lists the profiles a script
 * may use.
 *)
structure Config = struct
  (*! An AWS configuration. *)
  type config = aws_config

  (*! Credentials from the named SSO profile's cached token, and the
   * profile's region. A profile that is not a direct SSO profile is an
   * error when a service call loads it. *)
  fun sso_profile profile = aws_config_sso_profile profile
end
