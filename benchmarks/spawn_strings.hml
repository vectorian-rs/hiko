(* Send a 100,000-character string to 200 children and get one back from
 * each: the cost of strings crossing process boundaries. *)
import Std.Fiber
import Std.Int
import Std.Stdio
import Std.String

fun copies (s, n, acc) = if n = 0 then acc else copies (s, n - 1, s :: acc)

fun repeat (s, n) = String.join "" (copies (s, n, []))

fun spawn_all (text, n, acc) =
  if n = 0 then acc else spawn_all (text, n - 1, Fiber.spawn (fn () => text) :: acc)

fun await_all (pids, acc) =
  case pids of
      [] => acc
    | pid :: rest => await_all (rest, acc + String.length (Fiber.join_or_fail pid))

fun run () =
  let val text = repeat ("0123456789", 10000) in await_all (spawn_all (text, 200, []), 0) end

val _ = Stdio.println ("spawn_strings = " ^ Int.to_string (run ()))
