(* Fan-out of file I/O: walk .git once, then 32 children each read and
 * BLAKE3-hash a 32nd of the files. bun scripts/bench.ts points it at a copy of
 * the git directory when .git is a file. Needs a policy that allows
 * walk_dir and read_file_bytes there. *)
import Hash.Blake3
import Std.Bytes
import Std.Fiber
import Std.Filesystem
import Std.Int
import Std.Stdio

val target_dir = ".git"

val chunks = 32

fun hash_all (paths, acc) =
  case paths of
      [] => acc
    | path :: rest =>
      let
        val bytes = Filesystem.read_bytes path
        val _ = Blake3.hash bytes
      in
        hash_all (rest, acc + Bytes.length bytes)
      end

(* Split the files into contiguous chunks of `size`. *)
fun take (xs, n, acc) =
  case xs of
      [] => (acc, [])
    | x :: rest => if n = 0 then (acc, xs) else take (rest, n - 1, x :: acc)

fun split (xs, size) =
  case xs of
      [] => []
    | _ => let val (chunk, rest) = take (xs, size, []) in chunk :: split (rest, size) end

fun length (xs, n) = case xs of [] => n | _ :: rest => length (rest, n + 1)

fun spawn_all (lists, acc) =
  case lists of
      [] => acc
    | l :: ls => spawn_all (ls, Fiber.spawn (fn () => hash_all (l, 0)) :: acc)

fun await_all (pids, acc : int) =
  case pids of
      [] => acc
    | pid :: rest => await_all (rest, acc + Fiber.join_or_fail pid)

val files = Filesystem.walk target_dir

val size = (length (files, 0) + chunks - 1) / chunks

val total = await_all (spawn_all (split (files, size), []), 0)

val _ = Stdio.println ("fanout_hash = " ^ Int.to_string total)
