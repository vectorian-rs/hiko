(* Sieve of Eratosthenes — from Manticore seq-primes benchmark
 * Compute primes less than 1000
 *)

import Std.List
import Std.Int
import Std.Stdio
import Std.Testing

fun interval m n =
  if m > n then []
  else m :: interval (m + 1) n

fun remove_multiples n xs = case xs of
    [] => []
  | x :: rest =>
      if x mod n = 0
      then remove_multiples n rest
      else x :: remove_multiples n rest

fun sieve xs = case xs of
    [] => []
  | x :: rest => x :: sieve (remove_multiples x rest)

val primes = sieve (interval 2 200)
val count = List.length primes
val _ = Testing.equal count 46 "primes below 200"
val _ = Stdio.println ("primes below 200: " ^ Int.to_string count)
