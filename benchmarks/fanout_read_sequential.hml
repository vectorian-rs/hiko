(* Fan-out of sequential I/O: 32 processes each read README.md 100 times in
 * sequence. Needs a policy that allows read_file in the repository root. *)
fun reads (n, acc) = if n = 0 then acc else reads (n - 1, acc + string_length (read_file "README.md"))

fun spawn_all (n, acc) = if n = 0 then acc else spawn_all (n - 1, spawn (fn () => reads (100, 0)) :: acc)

fun await_all (pids, acc) =
  case pids of
      [] => acc
    | pid :: rest => await_all (rest, acc + await_process pid)

val total = await_all (spawn_all (32, []), 0)

val _ = println ("fanout_read_sequential = " ^ int_to_string total)
