(* 10,000 regex_match calls with one pattern and 2,000 regex_replace calls:
 * the cost of compiling a pattern that is used again and again. *)
import Std.Int
import Std.Regex
import Std.Stdio
import Std.String
import Std.Testing

fun count (n, acc) =
  if n = 0 then acc
  else count (n - 1, if Regex.matches "^order-[0-9]+$" ("order-" ^ Int.to_string n) then acc + 1 else acc)

fun replace_all (n, acc) =
  if n = 0 then acc
  else replace_all (n - 1, acc + String.length (Regex.replace "[0-9]+" "#" "a1b22c333"))

val total = count (10000, 0) + replace_all (2000, 0)

val _ = Testing.equal total (10000 + 2000 * 6) "regex_loop"

val _ = Stdio.println ("regex_loop = " ^ Int.to_string total)
