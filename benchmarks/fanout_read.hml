(* Fan-out of I/O-bound children: 1,000 processes each read README.md.
 * Needs a policy that allows read_file in the repository root. *)
import Std.Fiber
import Std.Filesystem
import Std.Int
import Std.Stdio
import Std.String

fun spawn_all (n, acc) =
  if n = 0 then acc else spawn_all (n - 1, Fiber.spawn (fn () => String.length (Filesystem.run (fn () => Filesystem.read_text "README.md"))) :: acc)

fun await_all (pids, acc : int) =
  case pids of
      [] => acc
    | pid :: rest => await_all (rest, acc + Fiber.join_or_fail pid)

val total = await_all (spawn_all (1000, []), 0)

val _ = Stdio.println ("fanout_read = " ^ Int.to_string total)
