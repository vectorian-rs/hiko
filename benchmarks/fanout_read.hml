(* Fan-out of I/O-bound children: 1,000 processes each read README.md.
 * Needs a policy that allows read_file in the repository root. *)
fun spawn_all (n, acc) =
  if n = 0 then acc else spawn_all (n - 1, spawn (fn () => string_length (read_file "README.md")) :: acc)

fun await_all (pids, acc) =
  case pids of
      [] => acc
    | pid :: rest => await_all (rest, acc + await_process pid)

val total = await_all (spawn_all (1000, []), 0)

val _ = println ("fanout_read = " ^ int_to_string total)
