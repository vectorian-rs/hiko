(* List recursion: the length of a 100,000-element list, 100 times. Each step
 * is a constructor pattern match. *)
fun build (n, acc) = if n = 0 then acc else build (n - 1, n :: acc)

fun len (xs, acc) =
  case xs of
      [] => acc
    | _ :: rest => len (rest, acc + 1)

val xs = build (100000, [])

fun repeat (k, total) = if k = 0 then total else repeat (k - 1, total + len (xs, 0))

val total = repeat (100, 0)

val _ = assert_eq (total, 10000000, "list_length")

val _ = println ("list_length = " ^ int_to_string total)
