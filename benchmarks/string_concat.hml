(* Build strings with ^ and string_join: the cost of creating new strings. *)
import Std.Int
import Std.Stdio
import Std.String

fun build (n, acc) =
  if n = 0 then acc else build (n - 1, Int.to_string n ^ "," :: acc)

fun total (xs, acc) =
  case xs of
      [] => acc
    | x :: rest => total (rest, acc + String.length (x ^ x))

val parts = build (200000, [])

val joined = String.join ";" parts

val n = total (parts, 0) + String.length joined

val _ = Stdio.println ("string_concat = " ^ Int.to_string n)
