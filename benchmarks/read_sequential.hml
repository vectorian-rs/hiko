(* One process reads README.md 1,000 times in sequence. Each read_file is an
 * async request to the I/O backend, so this measures the round trip from
 * request to resumed process. Needs a policy that allows read_file in the
 * repository root. *)
fun reads (n, acc) = if n = 0 then acc else reads (n - 1, acc + string_length (read_file "README.md"))

val total = await_process (spawn (fn () => reads (1000, 0)))

val _ = println ("read_sequential = " ^ int_to_string total)
