(* One process reads README.md 1,000 times in sequence. Each read_file is an
 * async request to the I/O backend, so this measures the round trip from
 * request to resumed process. Needs a policy that allows read_file in the
 * repository root. *)
import Std.Fiber
import Std.Filesystem
import Std.Int
import Std.Stdio
import Std.String

fun reads (n, acc) = if n = 0 then acc else reads (n - 1, acc + String.length (Filesystem.run (fn () => Filesystem.read_text "README.md")))

val total = Fiber.join_or_fail (Fiber.spawn (fn () => reads (1000, 0)))

val _ = Stdio.println ("read_sequential = " ^ Int.to_string total)
