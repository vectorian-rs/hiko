(* Spawn and await 6,000 trivial children: the cost of process creation
 * through the threaded runtime. *)
import Std.Fiber
import Std.Int
import Std.Stdio
import Std.Testing

fun spawn_all (n, acc) = if n = 0 then acc else spawn_all (n - 1, Fiber.spawn (fn () => n) :: acc)

fun await_all (pids, acc : int) =
  case pids of
      [] => acc
    | pid :: rest => await_all (rest, acc + Fiber.join_or_fail pid)

val total = await_all (spawn_all (6000, []), 0)

val _ = Testing.equal total 18003000 "spawn_await"

val _ = Stdio.println ("spawn_await = " ^ Int.to_string total)
