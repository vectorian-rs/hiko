(* Fibonacci with explicit continuations via algebraic effects
 * — from Manticore ec-fib benchmark
 * Cont.callec / Cont.throw mapped to perform/handle
 * Input: 25 => 75025
 *)

import Std.Int
import Std.Stdio
import Std.Testing

effect Ret of int

fun callec f =
  handle f ()
  with return x => x
     | Ret v _ => v

fun fib n =
  if n = 0 then perform Ret 0
  else if n = 1 then perform Ret 1
  else perform Ret (
    callec (fn _ => fib (n - 1)) +
    callec (fn _ => fib (n - 2))
  )

val result = callec (fn _ => fib 30)
val _ = Testing.equal result 832040 "ec_fib(30)"
val _ = Stdio.println ("ec_fib(30) = " ^ Int.to_string result)
