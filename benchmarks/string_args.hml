(* Pass a 10,000-character string to builtins: the cost of reading string
 * arguments. *)
import Std.Int
import Std.Stdio
import Std.String

fun copies (s, n, acc) = if n = 0 then acc else copies (s, n - 1, s :: acc)

fun repeat (s, n) = String.join "" (copies (s, n, []))

val text = repeat ("0123456789", 1000)

fun loop (n, acc) =
  if n = 0 then acc
  else loop (n - 1, acc + String.length text + String.length (String.substring (n mod 100) 10 text))

val _ = Stdio.println ("string_args = " ^ Int.to_string (loop (200000, 0)))
