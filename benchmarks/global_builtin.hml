(* A loop that calls a builtin through a global 3,000,000 times: the cost of
 * GetGlobal on a hot path. *)
import Std.Int
import Std.Stdio
import Std.Testing

fun loop (n, acc) = if n = 0 then acc else loop (n - 1, acc + Int.abs n)

val total = loop (3000000, 0)

val _ = Testing.equal total 4500001500000 "global_builtin"

val _ = Stdio.println ("global_builtin = " ^ Int.to_string total)
