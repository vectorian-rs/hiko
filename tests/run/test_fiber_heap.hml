import Std.Fiber
import Std.Stdio
import Std.String
import Std.Testing

fun build n acc = if n = 0 then acc else build (n - 1) (n :: acc)

val child = Fiber.spawn (fn () => build 200 [])

val heap_status =
  case Fiber.join child of
      Ok _ => 0
    | Err err => if String.contains "heap limit exceeded: " (Fiber.render_error err) then 1 else 0
    | _ => 0

val _ = Testing.equal heap_status 1 "heap limit exceeded"

val _ = Stdio.println "fiber heap tests passed"
