import Std.Fiber
import Std.Stdio
import Std.String
import Std.System
import Std.Testing
import Std.Time

val cancelled = Fiber.spawn (fn () => let
  val _ = Time.sleep (Time.from_ms 999999)
in
  42
end)

val _ = Fiber.cancel cancelled

fun is_error_message expected result =
  case result of
      Ok _ => 0
    | Err err => if Fiber.render_error err = expected then 1 else 0
    | _ => 0

val cancelled_status = is_error_message "cancelled" (Fiber.join cancelled)

val _ = Testing.equal cancelled_status 1 "cancelled join"

val joined_twice = Fiber.spawn (fn () => 42)

val first_join_status =
  case Fiber.join joined_twice of
      Ok value => if value = 42 then 1 else 0
    | Err _ => 0
    | _ => 0

val second_join_status = is_error_message "result unavailable/reaped; ownership no longer known" (Fiber.join joined_twice)

val _ = Testing.equal first_join_status 1 "first join ok"

val _ = Testing.equal second_join_status 1 "second join already joined"

val failed = Fiber.spawn (fn () => System.panic "boom")

val after_failure =
  case Fiber.join failed of
      Ok _ => 0
    | Err err => if String.contains "boom" (Fiber.render_error err) then 41 else 0
    | _ => 0

val _ = Testing.equal (after_failure + 1) 42 "parent continues after child failure"

val _ = Stdio.println "fiber error tests passed"
