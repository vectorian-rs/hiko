import Std.Int
import Std.Float
import Std.Char
import Std.Word
import Std.Path
import Std.System
import Std.Stdio
import Std.Testing

val int_of_string : string -> int = Int.of_string
val int_to_text : int -> string = Int.to_string
val float_of_int : int -> float = Float.of_int
val float_to_text : float -> string = Float.to_string
val char_of_int : int -> char = Char.of_int
val char_to_int : char -> int = Char.to_int
val word_of_int : int -> word = Word.of_int
val word_to_int : word -> int = Word.to_int
val word_of_string : string -> word = Word.of_string
val word_to_text : word -> string = Word.to_string
val path_join_pair : string * string -> string = Path.join
val exit_unit : int -> unit = System.exit
val panic_int : string -> int = System.panic
val panic_bool : string -> bool = System.panic

val _ = Testing.equal (Int.of_string " 42 ") (Int.of_string " 42 ") "Int.of_string"
val _ = Testing.equal (Int.to_string (~42)) (Int.to_string (~42)) "Int.to_string"
val _ = Testing.equal (Float.of_int 42) (Float.of_int 42) "Float.of_int"
val _ = Testing.equal (Float.to_string 2.75) (Float.to_string 2.75) "Float.to_string"
val _ = Testing.equal (Char.of_int 128512) (Char.of_int 128512) "Char.of_int"
val _ = Testing.equal (Char.to_int (Char.of_int 65)) 65 "Char round trip"
val _ = Testing.equal (Word.to_int (Word.of_int 42)) 42 "Word round trip"
val _ = Testing.equal (Word.of_string "42") (Word.of_string "42") "Word.of_string"
val _ = Testing.equal (Word.of_string "  42  ") (Word.of_string "  42  ") "Word whitespace"
val _ = Testing.equal (Word.to_string (Word.of_int 42)) (Word.to_string (Word.of_int 42)) "Word.to_string"
val _ = Testing.equal (Path.join ("a", "b")) (Path.join ["a", "b"]) "Path.join"
val _ = Testing.equal (Int.of_string "-9223372036854775808") (Int.of_string "-9223372036854775808") "Int minimum"
val _ = Testing.equal (Int.of_string "9223372036854775807") (Int.of_string "9223372036854775807") "Int maximum"
val _ = Testing.equal (Word.of_string "18446744073709551615") (Word.of_string "18446744073709551615") "Word maximum"
val _ = Testing.equal (Char.of_int 1114111) (Char.of_int 1114111) "Unicode maximum"
val _ = Testing.equal (Float.of_int 9223372036854775807) (Float.of_int 9223372036854775807) "Float rounding"
val _ = Testing.equal (Float.to_string (~0.0)) (Float.to_string (~0.0)) "Float negative zero"
val _ = Stdio.println "thin module tests passed"
