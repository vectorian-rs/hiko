import Std.Testing

local val y = 9 in fun h () = y end
val _ = Testing.equal (h ()) 9 "private scalar"

local
    val offset = 7
    fun private_add n = n + offset
in
    fun even (n : int) = if n = 0 then private_add 0 else odd (n - 1)
    and odd n = if n = 0 then offset + 1 else even (n - 1)
    fun pair (a : int, b : int) = a + b + offset
    fun returned n = fn m => private_add (n + m)
end
val old_even = even
val old_odd = odd
val _ = Testing.equal (even 6) 7 "mutual private function"
val _ = Testing.equal (odd 6) 8 "mutual private scalar"
val _ = Testing.equal (pair (2, 3)) 12 "captured tuple parameter"
val pair_value = pair
val _ = Testing.equal (pair_value (2, 3)) 12 "captured tuple function as value"
val _ = Testing.equal (returned 2 3) 12 "returned closure"
fun even (n : int) = 100 + n
fun odd (n : int) = 200 + n
val _ = Testing.equal (old_even 6) 7 "old recursive group after rebinding"
val _ = Testing.equal (old_odd 6) 8 "old sibling after rebinding"

val y = "outer"
local val y = 9 in fun read_private () = y end
val outer : string = y
val _ = Testing.equal outer "outer" "private type does not escape"
val _ = Testing.equal (read_private ()) 9 "private value still captured"

local val y = 9 in val y = 42 fun read_public () = y end
val _ = Testing.equal (read_public ()) 42 "export shadows private value"
local fun same (n : int) = n + 100 in
    fun same (n : int) = if n = 0 then 0 else same (n - 1)
end
val _ = Testing.equal (same 3) 0 "recursive export shadows private function"

local val a = 10 in
    local val b = 20 in fun nested () = a + b end
    fun still_outer () = a
end
val _ = Testing.equal (nested ()) 30 "nested private captures"
val _ = Testing.equal (still_outer ()) 10 "nested cleanup preserves outer private slot"

local val y = 9 in
    fun local_export () =
        let
            val y = 1
            local val y = 2 in val x = y end
        in x + y end
end
val _ = Testing.equal (local_export ()) 3 "function local private name stays hidden"

local val y = 9 in
    fun mixed n = if n = 0 then y else forward (n - 1)
    and forward (n : int) = mixed n
    fun shadow_param (y : int) = y + 1
    fun shadow_let () = let val y = 12 in y end
    fun shadow_case value = case value of y => y + 1
    fun nested_let () = let local val y = 12 in val y = 13 end in y end
end
val _ = Testing.equal (forward 4) 9 "mixed captured and direct members"
val _ = Testing.equal (shadow_param 2) 3 "parameter shadows private"
val _ = Testing.equal (shadow_let ()) 12 "let shadows private"
val _ = Testing.equal (shadow_case 2) 3 "case shadows private"
val _ = Testing.equal (nested_let ()) 13 "nested local public binding"

fun replaced (a : int, b : int) = a + b
local val offset = 9 in
    fun replaced (a : int, b : int) = a + b + offset
end
val _ = Testing.equal (replaced (1, 2)) 12 "captured export replaces direct and flat targets"

local datatype hidden = Hidden of int in
    fun wrap (n : int) = Hidden n
    fun unwrap value = case value of Hidden n => n
end
val _ = Testing.equal (unwrap (wrap 9)) 9 "private constructor capture"

val composed = 10 + local_export ()
val _ = Testing.equal composed 13 "private slots reclaimed inside expression"
