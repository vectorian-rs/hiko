import Std.Fiber
import Std.Stdio
import Std.Testing

val x = 1
val x = 2
val read_old = fn () => x
val x = 3
val x = 4
val first = Fiber.spawn read_old
val x = 5
val x = 6
val read_new = fn () => x
val second = Fiber.spawn read_new
val x = 7
val x = 8
val _ = Testing.equal (Fiber.join_or_fail first) 2 "earlier child binding"
val _ = Testing.equal (Fiber.join_or_fail second) 6 "later child binding"
val _ = Testing.equal (read_old ()) 2 "parent retains earlier binding"
val _ = Stdio.println "binding snapshots passed"
